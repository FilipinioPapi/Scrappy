{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scrappy Media Center",
  "version": "0.1.0",
  "identifier": "app.scrappy.player",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Scrappy Media Center",
        "width": 1400,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "libmpv/libmpv-2.dll": "libmpv-2.dll",
      "whisper/*": "whisper/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFODYyNDYyODQ3OUYxQzkKUldUSjhYbUVZaVNHWHJlMVNvcjFiLytMMEFSbDUvbTJuaUZmdDE0cDNjT0xtS2E2QjErSDJrVTAK",
      "endpoints": [],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
